{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "profile-clash",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-27",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
